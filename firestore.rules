rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validations ---

    function isValidUser(data) {
      return data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 256 &&
             (data.get('displayName', '') is string && data.get('displayName', '').size() <= 256) &&
             (data.get('photoURL', '') is string && data.get('photoURL', '').size() <= 1024);
    }

    function isValidProject(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 256 &&
             data.ownerId == request.auth.uid &&
             data.rowsCount is number &&
             data.colsCount is number &&
             data.size is number &&
             data.createdAt == request.time &&
             data.updatedAt == request.time;
    }

    function isValidRow(data) {
      return data.data is map &&
             data.index is number;
    }

    function isValidActionLog(data) {
      return data.type is string && data.type.size() <= 128 &&
             data.timestamp is number &&
             data.description is string && data.description.size() <= 1024;
    }

    // --- Match Blocks ---

    // Users
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && 
                      isValidUser(incoming()) && 
                      incoming().uid == existing().uid &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL']);
    }

    // Projects
    match /projects/{projectId} {
      allow get: if isOwner(existing().ownerId);
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      
      allow create: if isSignedIn() && isValidId(projectId) && isValidProject(incoming());
      
      allow update: if isOwner(existing().ownerId) && 
                      incoming().ownerId == existing().ownerId &&
                      incoming().createdAt == existing().createdAt &&
                      incoming().updatedAt == request.time &&
                      (
                        // Action: Update Metadata
                        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'rowsCount', 'colsCount', 'size', 'updatedAt'])
                      );
      
      allow delete: if isOwner(existing().ownerId);

      // Subcollections
      match /rows/{rowId} {
        allow get: if isOwner(get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId);
        allow list: if isOwner(get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId);
        allow create: if isOwner(get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId) && isValidRow(incoming());
        allow update: if isOwner(get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId) && isValidRow(incoming());
        allow delete: if isOwner(get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId);
      }

      match /history/{historyId} {
        allow get: if isOwner(get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId);
        allow list: if isOwner(get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId);
        allow create: if isOwner(get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId) && isValidActionLog(incoming());
        allow delete: if isOwner(get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId);
      }
    }
  }
}
